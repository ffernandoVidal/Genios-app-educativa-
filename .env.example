NEON_HOST=
NEON_DB=
NEON_USER=
NEON_PASSWORD=
ConnectionStrings__GeniosDatabase=
Autenticacion__Clave=
Autenticacion__GoogleClientId=

# --- Despliegue (variables de la API en Render; en local no hacen falta) ---
ASPNETCORE_ENVIRONMENT=Production
# Render define PORT solo; la API lo usa si existe.
# PORT=10000
# Origenes del frontend, sin barra final. Uno por indice: __0, __1...
Cors__OrigenesPermitidos__0=https://TU-PROYECTO.pages.dev
# Si el front y la API estan en dominios distintos y se usa la cookie de renovacion: None (requiere CookieSegura=true)
Autenticacion__CookieSameSite=Lax
# Solo para pruebas: cualquier cuenta Google obtiene rol docente. En produccion dejar en false o quitar.
Autenticacion__DocentePorGoogleAbierto=false
